# Required for the AI analysis step. Without it the tool still runs, but only
# reports measurable technical and structural checks.
ANTHROPIC_API_KEY=sk-ant-...

# Required to view the leads dashboard at /dashboard. Choose a strong value.
# Without it, the dashboard stays locked.
ADMIN_PASSWORD=change-me

# Optional. Overrides for the two pipeline models. The audit uses Haiku for the
# full report, guided by a short Sonnet "strategy" pass. Defaults shown.
# CRO_PRIMARY_MODEL=claude-haiku-4-5
# CRO_STRATEGIST_MODEL=claude-sonnet-5

# Optional. Where the SQLite lead store lives. Point this at a mounted volume in
# production so leads survive redeploys. Defaults to ./data.
# CRO_DATA_DIR=/data

# Optional. JSON object of headers sent with every audit request, so you can
# allowlist this auditor in your own WAF/CDN (e.g. SiteGround, Cloudflare) by a
# shared secret rather than being blocked as a bot.
# CRO_AUDIT_HEADERS={"X-CRO-Audit":"your-shared-secret"}
